# KAIROS — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e preencha. Nunca versione .env.local.
# Toda chave nova entra aqui no mesmo PR (ver skill env-config).

# ---------------------------------------------------------------- ambiente
NODE_ENV=development
KAIROS_ENV=dev
TZ=America/Sao_Paulo

# ---------------------------------------------------------------- banco
# Docker Compose: postgres://kairos:kairos@localhost:5432/kairos
DATABASE_URL="postgresql://kairos:kairos@localhost:5432/kairos?schema=public"

# ---------------------------------------------------------------- autenticação
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-de-no-minimo-32-caracteres-aleatorios"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------- arquivos (S3 / MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="kairos"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# ---------------------------------------------------------------- provedor fiscal
# Em desenvolvimento use o provedor simulado; não aponte para produção.
FISCAL_PROVEDOR="simulado"
FISCAL_PROVEDOR_URL="http://localhost:3000/api/simulado/fiscal"
FISCAL_PROVEDOR_TOKEN="token-de-desenvolvimento"

# ---------------------------------------------------------------- e-mail
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_REMETENTE="kairos@pureus.local"

# ---------------------------------------------------------------- observabilidade
LOG_LEVEL=debug
# SENTRY_DSN=
