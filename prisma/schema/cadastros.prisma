// Contexto: cadastros
// Linhas comerciais e produtos acabados. Insumos, parceiros e depósitos entram
// na fase 1. Tabelas com tenant_id recebem RLS na migration.

/// Linha comercial, como "Brilho Supremo / Anti Frizz". Agrupa catálogo e romaneio.
model LinhaProduto {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  nome         String   @db.VarChar(60)
  /// Apelo comercial exibido depois da barra: "Anti Frizz", "Reconstrução".
  apelo        String?  @db.VarChar(80)
  /// Cor da faixa da linha nos documentos, em #RRGGBB.
  cor          String   @db.VarChar(7)
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produtos Produto[]

  @@unique([tenantId, nome])
  @@index([tenantId, ativo, ordem])
  @@map("linha_produto")
}

/// Produto acabado vendido pela empresa.
model Produto {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  linhaId       String   @map("linha_id") @db.Uuid
  codigo        String   @db.VarChar(20)
  nome          String   @db.VarChar(120)
  /// GTIN-13 da unidade de venda.
  ean           String?  @db.VarChar(13)
  /// GTIN-14 da caixa de embarque.
  dun14         String?  @db.VarChar(14)
  ncm           String   @db.VarChar(8)
  cest          String?  @db.VarChar(7)
  /// CST do ICMS (regime normal) ou CSOSN (Simples Nacional), 3 dígitos.
  cstCsosn      String   @map("cst_csosn") @db.VarChar(3)
  comprimentoCm Decimal? @map("comprimento_cm") @db.Decimal(7, 2)
  larguraCm     Decimal? @map("largura_cm") @db.Decimal(7, 2)
  alturaCm      Decimal? @map("altura_cm") @db.Decimal(7, 2)
  preco         Decimal  @db.Decimal(12, 2)
  /// Unidades por caixa de embarque.
  caixaMaster   Int      @map("caixa_master")
  /// Unidades por box (embalagem intermediária). Nulo quando o produto só sai em caixa master.
  caixaBox      Int?     @map("caixa_box")
  ordem         Int      @default(0)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  linha         LinhaProduto   @relation(fields: [linhaId], references: [id], onDelete: Restrict)
  ncmRef        Ncm            @relation(fields: [ncm], references: [codigo], onDelete: Restrict)
  itensRomaneio RomaneioItem[]

  @@unique([tenantId, codigo])
  @@unique([tenantId, ean])
  @@index([tenantId, linhaId, ativo])
  @@map("produto")
}
